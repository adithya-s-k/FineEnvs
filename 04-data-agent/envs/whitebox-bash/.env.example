# Sandbox provider. Required by the SERVER; the trainer client never needs it.
E2B_API_KEY=

# Where the trainer client finds the hosted environment.
WHITE_BOX_BASH_URL=http://127.0.0.1:8000

# Optional: swap the built-in task suite for a Hub dataset.
# WHITE_BOX_BASH_DATASET=HuggingEnvs/white-box-bash

# Bounds. MAX_SESSIONS is the real concurrency ceiling -- see server/environment.py.
WHITE_BOX_BASH_MAX_SESSIONS=200
WHITE_BOX_BASH_SANDBOX_TIMEOUT_S=1800
