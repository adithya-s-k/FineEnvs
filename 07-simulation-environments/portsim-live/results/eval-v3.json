{
  "env": "portsim-marine",
  "version": "v3",
  "authors": [
    {
      "name": "Edgar Arakelyan",
      "github": "earakely-scale",
      "affiliation": "Scale AI"
    }
  ],
  "framework": "agentenv",
  "tasks": {
    "split": "eval",
    "n": 15,
    "source": "the Port of Barcelona's 2024 container calls at quays 24B (APM Terminals Barcelona) and 36A (Terminal Catalunya, BEST), as PortSimEnv's dock-v1-eval one-week standard and busy weeks, with the port's 2024 pilot and tug traffic",
    "selection": "the 15 live weeks with the port's pilots and tugs, all qualifying as live weeks do: the weeks where the rolling re-planner, re-planning on the week as known at every watch, reaches the hindsight optimum in at least 3 of its 4 solver configurations"
  },
  "harness": {
    "agent": "portsim-llm",
    "tools": [
      "get_situation",
      "check_plan",
      "confirm_berths",
      "advance"
    ],
    "max_turns": 47
  },
  "grading": {
    "reference": "the hindsight optimum: the plan CP-SAT proves optimal on the week as it really happened",
    "reward": "a feasible week scores 0.2 + 0.8 exp(-g/0.5), g = max(0, cost - reference) / (max(0, reference - floor) + 100), the floor being the cost no plan can avoid; a week that breaks a rule scores 0.2 times its share of clean ships, below 0.2, and a ship left without a window breaks a rule; graded once, on the windows confirmed and the week as it really happened",
    "excused": "cost or rule breaks that news brings to a window after its last chance to change (once it froze)",
    "judge": false
  },
  "baselines": [
    {
      "name": "rolling re-planner",
      "mean": 1.0
    },
    {
      "name": "naive policy",
      "mean": 0.1866
    }
  ],
  "models": [
    {
      "model": "GPT-6 Astra",
      "provider": "Azure OpenAI",
