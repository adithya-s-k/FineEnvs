# AirOpsEnv v2 as an AgentEnv environment: airops-occ, the ops control center on JetBlue's whole network, with the
# b6-v2 pack, on port 18765. Build context: envs/airops, with the pack fetched first (tools/fetch_packs.py);
# Dockerfile.occ.dockerignore keeps the rest out.
#   docker build -f agentenv/Dockerfile.occ -t airops-occ-agentenv .
FROM python:3.12-slim
LABEL org.opencontainers.image.source="https://github.com/adithya-s-k/FineEnvs" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.description="AirOpsEnv v2, the ops control center, as an AgentEnv environment. Built from public U.S. records: BTS on-time and T-100 data, the FAA registry and FAA Command Center advisories; crews generated from the published schedule under FAR 117 and 14 CFR 121.467."
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 AIROPS_OCC_PACK=/app/tasks/b6-v2
# The versions the published runs were recorded with.
RUN pip install "agentenv-framework-protocol==0.1.338" "fastmcp==3.4.8" "mcp==1.30.0" "pydantic==2.13.5" "tzdata" \
    "httpx==0.28.1" "numpy==2.5.4" "pandas==3.0.6" "highspy==1.15.1" "airportsdata==20260905"
WORKDIR /app
COPY core /app/core
COPY agentenv/pyproject.toml /app/agentenv/pyproject.toml
COPY agentenv/airops_agentenv /app/agentenv/airops_agentenv
COPY tasks/b6-v2 /app/tasks/b6-v2
RUN pip install --no-deps /app/core /app/agentenv && useradd --create-home --uid 1000 airops
USER airops
EXPOSE 18765
CMD ["python", "-m", "airops_agentenv.occ_server"]
