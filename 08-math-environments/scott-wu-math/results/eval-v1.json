{
  "env": "scott-wu-math",
  "version": "v1",
  "authors": [
    {
      "name": "Adithya S Kolavi",
      "github": "adithya-s-k",
      "affiliation": "Hugging Face"
    }
  ],
  "framework": "openenv",
  "tasks": {
    "split": "test",
    "n": 20,
    "source": "deals generated by envs/scott_wu_math/scripts/build_tasks.py; every deal is checked by the solver to have a solution",
    "selection": "the first five test deals of each level (24, three-digit, year, four-digit): indices 0, 1, 2, 3, 4, 50, 51, 52, 53, 54, 100, 101, 102, 103, 104, 150, 151, 152, 153, 154"
  },
  "harness": {
    "agent": "eval/rollout.py, one OpenEnv session per episode",
    "tools": [],
    "max_turns": 1,
    "modes": {
      "think": "the model's own reasoning at high effort, up to 32k output tokens",
      "nothink": "reasoning off, or as low as the API allows, up to 32k output tokens",
      "direct": "no reasoning, the answer tag alone, 300 output tokens"
    }
  },
  "grading": {
    "reference": "the target, made from every card exactly once with + - x / and parentheses",
    "reward": "1.0 for an exact answer; 0.3 c^2 with c = 1 - |value - target| / (0.1 target) for a valid expression within 10% of the target; 0 otherwise",
    "excused": "nothing",
    "judge": false
  },
  "baselines": [],
