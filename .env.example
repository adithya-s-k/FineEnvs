# Copy this file to `.env` at the repo root and fill in real values.
# Every rollout.py in this repo reads from RL_Envs_101/.env via python-dotenv.

# --- LLM provider (pick at least one) -----------------------------------------

# Hugging Face Inference Providers — used when ROLLOUT_MODEL contains a `:provider`
# suffix (default model is Qwen/Qwen3-Coder-480B-A35B-Instruct:together).
# Get a token at https://huggingface.co/settings/tokens
HF_TOKEN=hf_...

# OpenAI native — used when ROLLOUT_MODEL has no `:` (e.g. gpt-4o-mini, gpt-5).
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# OpenRouter — used by eval/run_eval.py for the hosted model boards.
OPENROUTER_API_KEY=sk-or-v1-...

# --- Sandbox backend ----------------------------------------------------------

# E2B Code Interpreter — required for:
#   - any in-process env (verifiers, skyrl_gym, gem) -- the sandbox is created
#     in the rollout process
#   - running OpenEnv / ORS / NeMo Gym SERVERS locally (the deployed HF Spaces
#     already have this baked in)
# Get a key at https://e2b.dev
E2B_API_KEY=e2b_...

# --- Optional: W&B logging (not used by rollouts, only by training scripts) ---
# WANDB_API_KEY=
