# Wordle NeMo Gym Resources Server, built from adithya-s-k/FineEnvs
# (00-environments-101/envs/wordle). The Space holds this file as Dockerfile,
# README.spaces.md as README.md, and server.py, pyproject.toml, uv.lock,
# configs/ and ../core/ beside it. Dependencies come from uv.lock, which pins
# the NeMo Gym commit the repo's tests run against: NeMo Gym's HEAD needs
# Python >= 3.13 and would otherwise be pulled in unpinned.
FROM python:3.12-slim AS builder
RUN apt-get update && apt-get install -y --no-install-recommends gcc git \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir uv
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project --no-cache

FROM python:3.12-slim
RUN useradd -m -u 1000 user
WORKDIR /app
COPY --from=builder /app/.venv /app/.venv
COPY core ./core
COPY configs ./configs
COPY server.py ./
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH=/app \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
USER user
EXPOSE 11000
CMD ["python", "server.py"]
